{
  "name": "dsh-connect-huaweicloud",
  "version": "0.0.5",
  "description": "把华为云果办 OfficeAce 接进 DeepSeek Harness：有客户端就自动读登录态，没有就浏览器登录；多账号进一张池，可勾选、可切换、失败自动换号。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "xinstart-1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinstart-1/dsh-connect-huaweicloud.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "officeace",
    "huaweicloud",
    "model-provider",
    "account-pool"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-client.mjs && node scripts/check-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "gate": "node scripts/gate.mjs",
    "prepack": "node scripts/gate.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <2.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@types/node": "^24.0.0",
    "tsdown": "0.15.6",
    "typescript": "5.9.3"
  }
}
